{
  "name": "nextjs-blog-starter",
  "version": "0.2.0",
  "private": true,
  "description": "Next.js App Router blog starter: typed posts, categories, tags, authors, client search, pagination, related posts, RSS feed, reading-time/TOC helpers, and dark mode.",
  "license": "MIT",
  "author": "Viprasol Tech Private Limited",
  "homepage": "https://github.com/Viprasol-Tech/nextjs-blog-starter#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Viprasol-Tech/nextjs-blog-starter.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "^15.5.29",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "20.19.43",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.6.2",
    "jsdom": "24.1.3",
    "postcss": "8.5.33",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
